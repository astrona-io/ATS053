{
  "context": "kind-astro-ats-053-lab-050-01-01",
  "resources": [
    {
      "kind": "networkpolicy",
      "name": "allow-shuttle",
      "namespace": "starfleet",
      "expected": {
        "apiVersion": "networking.k8s.io/v1",
        "kind": "NetworkPolicy",
        "metadata": {
          "name": "allow-shuttle",
          "namespace": "starfleet"
        },
        "spec": {
          "podSelector": {
            "matchLabels": {
              "app": "probe"
            }
          },
          "policyTypes": [
            "Ingress"
          ],
          "ingress": [
            {
              "from": [
                {
                  "namespaceSelector": {
                    "matchLabels": {
                      "kubernetes.io/metadata.name": "starfleet"
                    }
                  }
                }
              ],
              "ports": [
                {
                  "port": 8080,
                  "protocol": "TCP"
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "behavior": [
    {
      "args": [
        "kubectl",
        "-n",
        "starfleet",
        "exec",
        "shuttle",
        "--",
        "python",
        "-c",
        "import urllib.request; print(urllib.request.urlopen('http://probe:8080/',timeout=4).read().decode())"
      ],
      "contains": [
        "probe-ready"
      ]
    },
    {
      "args": [
        "kubectl",
        "-n",
        "outpost",
        "exec",
        "drifter",
        "--",
        "python",
        "-c",
        "import urllib.request; urllib.request.urlopen('http://probe.starfleet.svc:8080/',timeout=3).read()"
      ],
      "denied": true,
      "failure_markers": [
        "timed out"
      ]
    }
  ]
}
